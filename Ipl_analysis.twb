      <aliases enabled='yes' />
      <column caption='performace score' datatype='real' name='[Calculation_0221698067275776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [role]=&quot;Batsman&quot; THEN&#10;[runs]*0.5+[Strike rate]*2&#10;&#10;ELSEIF [role]=&quot;Bowler&quot; THEN&#10;[wickets]*20-[Economy]*10&#10;&#10;ELSEIF [role]=&quot;All-rounder&quot; THEN&#10;([runs]*0.3)+([wickets]*15)&#10;&#10;ELSEIF [role]=&quot;Wicketkeeper&quot; THEN&#10;[runs]*0.5+[Strike rate]*2&#10;&#10;&#10;END' />
      </column>
      <column caption='performance per crore' datatype='real' name='[Calculation_0221698067496961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0221698067275776]/[auction_price]' />
      </column>
      <column caption='total team cost' datatype='integer' name='[Calculation_0221698068258818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([auction_price (players )])' />
      </column>
      <column caption='expected team performace' datatype='real' name='[Calculation_0221698068381699]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0221698067275776])' />
      </column>
      <column caption='budget' datatype='real' name='[Calculation_0221698068512772]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([auction_price (players )])/80*100' />
      </column>
      <column caption='value score' datatype='real' name='[Calculation_0221698071658501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [role] = &quot;Batsman&quot; THEN&#10;[runs] + [Strike rate]&#10;&#10;ELSEIF [role] = &quot;Bowler&quot; THEN&#10;([wickets] * 20) - ([Economy] * 10)&#10;&#10;ELSEIF [role] = &quot;All Rounder&quot; THEN&#10;([runs] * 0.3) + ([wickets] * 15)&#10;&#10;END' />
      </column>
